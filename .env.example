# Copy to .env.local and fill in real values.
DATABASE_URL="file:./dev.db"
# Mật khẩu để đăng nhập (chỉ một mình bạn dùng).
OWNER_PASSWORD="change-me"
# Bí mật ký session cookie. Có thể sinh bằng: openssl rand -hex 32
SESSION_SECRET="please-change-me-to-a-long-random-string"
# GitLab API key (gitlawb.com)
GITLAB_API_KEY="your-gitlab-api-key-here"
